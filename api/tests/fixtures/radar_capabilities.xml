<?xml version="1.0" encoding="UTF-8"?>
<WMS_Capabilities xmlns="http://www.opengis.net/wms" version="1.3.0">
  <Service>
    <Name>WMS</Name>
    <Title>Weather Radar Base Reflectivity Mosaics</Title>
  </Service>
  <Capability>
    <Layer>
      <Title>Weather Radar Base Reflectivity Mosaics</Title>
      <Layer queryable="0">
        <Name>conus_base_reflectivity_mosaic</Name>
        <Title>CONUS Weather Radar Base Reflectivity</Title>
        <Abstract>
          Weather radar mosaics updated approximately every 4 minutes.
          Data source: NWS and OAR Multi-Radar Multi-Sensor (MRMS) System.
        </Abstract>
        <Dimension
          name="time"
          default="2026-07-29T12:48:14Z"
          units="ISO8601"
          nearestValue="1"
        >2026-07-29T12:36:01.000Z,2026-07-29T12:40:03.000Z,2026-07-29T12:44:17.000Z,2026-07-29T12:48:14.000Z</Dimension>
        <Style>
          <Name>weather_radar_base_reflectivity</Name>
          <Title>Weather Radar Base Reflectivity</Title>
          <LegendURL width="272" height="21">
            <Format>image/png</Format>
            <OnlineResource
              xmlns:xlink="http://www.w3.org/1999/xlink"
              xlink:type="simple"
              xlink:href="https://nowcoast.noaa.gov/geoserver/observations/weather_radar/ows?service=WMS&amp;request=GetLegendGraphic&amp;format=image%2Fpng&amp;layer=conus_base_reflectivity_mosaic"
            />
          </LegendURL>
        </Style>
      </Layer>
    </Layer>
  </Capability>
</WMS_Capabilities>
