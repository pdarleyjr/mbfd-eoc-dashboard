# Runtime identity
EOC_ENVIRONMENT=development
EOC_RELEASE_SHA=development
EOC_BUILD_ID=local
EOC_PUBLIC_ORIGIN=http://localhost:8220

# Backend persistence (production values must be generated, never committed)
EOC_DATABASE_URL=postgresql+asyncpg://eoc:replace-with-generated-password@eoc-postgres:5432/eoc
EOC_REDIS_URL=redis://:replace-with-generated-password@eoc-redis:6379/0
POSTGRES_DB=eoc
POSTGRES_USER=eoc
POSTGRES_PASSWORD=replace-with-generated-password
REDIS_PASSWORD=replace-with-generated-password

# Browser maps configuration. These values are compiled into the SPA and must
# be HTTP-referrer restricted. Never put server-side secrets in VITE_* values.
VITE_GOOGLE_MAPS_API_KEY=replace-with-referrer-restricted-browser-key
VITE_GOOGLE_MAPS_MAP_ID=replace-with-map-id

# Existing internal/public services
EOC_PULSEPOINT_URL=https://pulsepoint-proxy.pdarleyjr.workers.dev/incidents
EOC_OLLAMA_URL=http://172.20.0.1:11437
EOC_OLLAMA_MODEL=qwen3.5:9b
EOC_MAXUN_URL=http://eoc-maxun-backend:8080
EOC_MAXUN_ENABLED=false
EOC_HERMES_HEALTH_URL=

# Optional observability
EOC_SENTRY_DSN=
EOC_OTEL_EXPORTER_OTLP_ENDPOINT=

# Upstream identity required by api.weather.gov
EOC_USER_AGENT=MBFD-EOC/1.0 (operations-contact@mbfdhub.com)

# Security and behavior
EOC_DOCS_ENABLED=true
EOC_RATE_LIMIT_PER_MINUTE=240
EOC_RAW_SNAPSHOT_DIR=/app/data/raw-snapshots
EOC_ALLOWED_HOSTS=localhost,127.0.0.1,eoc.mbfdhub.com
EOC_CORS_ORIGINS=http://localhost:5173
